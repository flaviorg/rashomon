---
graph TD;
	__start__([<p>__start__</p>]):::first
	ground(ground)
	dispatch(dispatch)
	interpret(interpret)
	diff_plans(diff_plans<hr/><small><em>defer = True</em></small>)
	score_convergence(score_convergence)
	draft_questions(draft_questions)
	ask(ask)
	write_spec(write_spec)
	remember(remember)
	approve_post(approve_post)
