# No key at all: rashomon uses the scripted fake model (offline, demo only).

# Anthropic (default real model: anthropic:claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# Pick any LangChain "provider:model" id. --model wins over RASHOMON_MODEL.
# RASHOMON_MODEL=anthropic:claude-sonnet-5-5
# RASHOMON_MODEL=openai:gpt-5.1

# OpenAI or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.example.com/v1

# OpenRouter: RASHOMON_MODEL=openrouter:<vendor>/<model>
# OPENROUTER_API_KEY=
